{
  "step": "build",
  "module": 4,
  "observability_pillars": {
    "structured_logging": {
      "file": "apps/api/src/utils/logger.ts",
      "required_fields": ["timestamp", "level", "message", "service_name", "request_id"],
      "security_hardening": "Automatic secret key redaction, CRLF neutralization, and inline URI credential scrubbing (://[REDACTED]@)"
    },
    "prometheus_metrics": {
      "files": ["apps/api/src/utils/metrics.ts", "apps/api/src/middleware/metrics.middleware.ts", "apps/api/src/app.ts"],
      "endpoint": "GET /metrics",
      "metrics": [
        "http_requests_total{method,path,status}",
        "http_request_duration_seconds{method,path,status}",
        "Node.js default process metrics (CPU, memory, event loop lag)"
      ],
      "cardinality_protection": "Normalizes dynamic route segments (/r/:code, /links/:id) to prevent time-series explosion"
    },
    "alert_definitions": {
      "file": "infra/alerts.yml",
      "rules": [
        { "name": "HighErrorRate", "threshold": "5xx > 5% over 5m", "for": "2m", "severity": "critical" },
        { "name": "HighLatency", "threshold": "p95 > 2s over 5m", "for": "3m", "severity": "warning" },
        { "name": "ServiceDown", "threshold": "up == 0", "for": "1m", "severity": "critical" }
      ]
    }
  },
  "failure_first_drill": {
    "script": "scripts/verify-module-04-observability.ts",
    "result": "PASSED",
    "verified_counters": {
      "GET /live 200": 6,
      "GET /health 200": 2,
      "GET /unknown-route 404": 1,
      "GET /debug/simulate-error 500": 1
    }
  }
}
