{
  "step": "build",
  "module": 2,
  "pipeline_file": ".github/workflows/ci.yml",
  "pipeline_stages": [
    {
      "stage": "lint_and_test",
      "commands": ["npm ci", "cd apps/api && npx prisma generate", "npm run lint", "npm run build", "npm test"],
      "fail_fast": true
    },
    {
      "stage": "docker_build",
      "tagging": ["myservice:${{ github.sha }}", "myservice:latest"],
      "gated_by_tests": true
    },
    {
      "stage": "size_guardrail",
      "max_bytes": 209715200,
      "rule": "fails pipeline if image size exceeds 200MB"
    },
    {
      "stage": "registry_push",
      "registry": "ghcr.io",
      "secret_handling": "${{ secrets.GITHUB_TOKEN }} (no hardcoded credentials)",
      "branch_gate": "github.event_name == 'push' && github.ref == 'refs/heads/main'"
    }
  ],
  "pipeline_hardening": {
    "timeout_minutes": 15,
    "dependency_caching": "npm cache key mapped to **/package-lock.json",
    "git_sha_immutability": true
  }
}
