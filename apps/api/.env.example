# .env.example -- Copy to .env and fill in values
# This file documents every environment variable the service needs.
# Variables marked REQUIRED have no default and must be set.
# Variables marked OPTIONAL have a default noted in the comment.

# --- Application ---
APP_ENV=development# REQUIRED. One of: development, staging, production, test
NODE_ENV=development# OPTIONAL. One of: development, staging, production, test
PORT=3000          # OPTIONAL. Default: 3000. Integer. The port the server listens on.

# --- Database ---
DATABASE_URL=file:./dev.db # REQUIRED. Connection string, e.g. postgres://user:pass@host:5432/db or file:./dev.db

# --- Authentication ---
JWT_SECRET=super-secret-jwt-key-for-local-development-32chars # REQUIRED. Min 32 characters. Used to sign auth tokens.

# --- CORS ---
CORS_ORIGIN=http://localhost:3000 # OPTIONAL. Default: http://localhost:3000. Allowed origin URL.

# --- Logging ---
LOG_LEVEL=info     # OPTIONAL. Default: info. One of: debug, info, warn, error

# --- Cache & Queues ---
REDIS_URL=redis://localhost:6379 # OPTIONAL. Default: redis://localhost:6379
